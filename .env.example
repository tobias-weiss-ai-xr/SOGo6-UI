# Copy to .env.development or .env.local and restart `npm run dev`.

# User API base (trailing slash optional). Unset or unreachable → /fakeApi in development only.
REACT_APP_API_BASE_URL=http://127.0.0.1:5000/api/user/v1

# Mock-only mode (no backend required):
# REACT_APP_API_BASE_URL=/fakeApi

# Real-time mail events. Default in .env.development is false for faster local dev.
# SSE_ENABLED=true

# Admin panel hostnames (comma-separated)
# NEXT_PUBLIC_ADMIN_DOMAINS=admin.localhost

# Optional login prefill (served by GET /env at runtime)
LOGIN_PREFILL_EMAIL=sogo-tests1@example.org
LOGIN_PREFILL_PASSWORD=sogo

# ---------------------------------------------------------------------------
# PWA / Offline (Serwist)
# ---------------------------------------------------------------------------
# Enable PWA features (default: disabled). Requires a production build.
# NEXT_PUBLIC_PWA_ENABLED=true

# PWA modules (auto-enabled when NEXT_PUBLIC_PWA_ENABLED=true):
# NEXT_PUBLIC_PWA_OUTBOX=true
# NEXT_PUBLIC_PWA_MAIL_CACHE=true
# NEXT_PUBLIC_PWA_CALENDAR_CACHE=true
# NEXT_PUBLIC_PWA_BG_SYNC=true

# Start URL for PWA install and offline fallback retry
# NEXT_PUBLIC_PWA_START_URL=/

# Base path for precached assets (same as next.config.js basePath)
# Do NOT set unless you deploy to a subpath (e.g. /my-app)
# NEXT_PUBLIC_BASE_PATH=
