# OpenSpec files are version-controlled (the parent SOGo6-dockerized repo's
# openspec-validate workflow requires each submodule to ship project.spec.md,
# specs/ and changes/). Only local scratch files are ignored.

# Temporary files
*.tmp
*.swp
*~

# IDE files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# OS specific files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Backup files
*.bak
*.backup

# Environment
.env
.env.*
