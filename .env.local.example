# SOGo6 UI Environment Configuration
# Copy this file to .env.local and customize for your environment
# Never commit .env.local to version control

# ======================================
# API Configuration
# ======================================

# Base URL for the SOGo6 backend API
# In development: Use http://localhost:5000/api/v1 or leave as /api/v1 (uses proxy)
# In production: Set to the full URL of your backend server
# Trailing slash is optional
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Enable fake API for development (no backend required)
# When TRUE: Uses mock data from /fakeApi routes
# When FALSE: Proxies to NEXT_PUBLIC_API_BASE_URL
# In production: This is always ignored (FALSE)
NEXT_PUBLIC_ENABLE_FAKE_API=true

# ======================================
# Server-Sent Events (Real-time updates)
# ======================================

# Enable Server-Sent Events for real-time mail notifications
# Default: false (disabled for faster local development)
# In production: Set to true for real-time features
NEXT_PUBLIC_SSE_ENABLED=false

# SSE endpoint URL (for real-time notifications)
# Default: uses API_BASE_URL + /sse
# NEXT_PUBLIC_SSE_ENDPOINT=http://localhost:5000/api/user/v1/sse

# ======================================
# Admin Panel Configuration
# ======================================

# Admin panel hostnames (comma-separated)
# These domains will redirect to the admin panel
# Example: admin.localhost,admin.example.com
NEXT_PUBLIC_ADMIN_DOMAINS=admin.localhost

# ======================================
# Authentication & Demo Configuration
# ======================================

# Demo login credentials (optional, for development only)
# These are served by GET /env at runtime for convenience
LOGIN_PREFILL_EMAIL=sogo-tests1@example.org
LOGIN_PREFILL_PASSWORD=sogo

# ======================================
# Internationalization (i18n)
# ======================================

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Available locales (comma-separated)
NEXT_PUBLIC_LOCALES=en,de

# ======================================
# Session Configuration
# ======================================

# JWT token storage key
NEXT_PUBLIC_JWT_STORAGE_KEY=sogo6_jwt_token

# Refresh token storage key
NEXT_PUBLIC_REFRESH_TOKEN_STORAGE_KEY=sogo6_refresh_token

# Session expiration in hours
NEXT_PUBLIC_SESSION_EXPIRATION_HOURS=8

# ======================================
# Security Configuration
# ======================================

# CSRF protection
NEXT_PUBLIC_CSRF_ENABLED=true

# Content Security Policy (CSP)
# NEXT_PUBLIC_CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'

# ======================================
# Cache Configuration
# ======================================

# Enable API response caching
NEXT_PUBLIC_API_CACHE_ENABLED=false

# Cache TTL in seconds
NEXT_PUBLIC_API_CACHE_TTL=60

# ======================================
# Logging Configuration
# ======================================

# Enable debug logging for API client
NEXT_PUBLIC_API_DEBUG=false

# Enable console logging in development
NEXT_PUBLIC_CONSOLE_LOGGING=true

# ======================================
# Feature Flags
# ======================================

# Enable experimental features
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false

# Enable beta features
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# ======================================
# Analytics & Tracking (Optional)
# ======================================

# Google Analytics Measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ======================================
# Third-party Integrations
# ======================================

# OpenCloud integration
NEXT_PUBLIC_OC_ENABLED=false
NEXT_PUBLIC_OC_SERVER_URL=
NEXT_PUBLIC_OC_USERNAME=
NEXT_PUBLIC_OC_PASSWORD=

# Matrix/Element integration
NEXT_PUBLIC_MATRIX_ENABLED=false
NEXT_PUBLIC_MATRIX_SERVER=
NEXT_PUBLIC_MATRIX_USERNAME=
NEXT_PUBLIC_MATRIX_PASSWORD=

# Jitsi integration
NEXT_PUBLIC_JITSI_ENABLED=false
NEXT_PUBLIC_JITSI_SERVER=

# ======================================
# Notifications Configuration
# ======================================

# Enable desktop notifications
NEXT_PUBLIC_DESKTOP_NOTIFICATIONS_ENABLED=true

# Enable push notifications (Service Worker)
NEXT_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false

# VAPID public key for push notifications
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
